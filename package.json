{
  "name": "altoneo-charting",
  "version": "0.3.0",
  "description": "Bibliothèque de composants Vue 3 + TailwindCSS portant l'identité visuelle Altonéo",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ITS-53/Altoneo-Charting.git"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./style.css": "./src/style.css",
    "./next.css": "./src/next.css",
    "./icons": "./src/icons/registry.js",
    "./icons/svg/*": "./src/icons/svg/*",
    "./css": "./dist/altoneo.css",
    "./tokens": "./src/tokens/colors.js",
    "./assets/*": "./src/assets/*"
  },
  "files": [
    "src",
    "dist",
    "html",
    "powershell",
    "tailwind-preset.cjs",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "scripts": {
    "playground": "vite --config playground/vite.config.js",
    "build-playground": "vite build --config playground/vite.config.js",
    "preview-playground": "vite preview --config playground/vite.config.js",
    "build": "vite build",
    "icons": "node scripts/build-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "3.6.0-rc.14",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vue": "$vue",
    "@vue/server-renderer": "$vue",
    "nanoid": "^5.1.6",
    "brace-expansion": "^5.0.9",
    "source-map-js": "^1.2.2",
    "browserslist": "^4.28.7",
    "baseline-browser-mapping": "^2.11.0",
    "postcss-selector-parser": "^7.1.6",
    "postcss": "$postcss"
  }
}
